# Frontend Environment Variables (Vite - must be prefixed with VITE_)
# These are embedded into the frontend build

# Backend API base URL (e.g., https://api.example.com or http://localhost:3000)
VITE_API_BASE_URL=

# Use mock uploads (true) or real S3 uploads (false)
VITE_USE_MOCK_UPLOADS=true

# Use backend schedule API (true) or localStorage only (false)
VITE_USE_BACKEND_SCHEDULE=false

# Bearer token for API authentication (optional, falls back to localStorage token)
VITE_API_AUTH_TOKEN=

# Schedule channel identifier
VITE_CHANNEL=default

# Schedule week identifier
VITE_WEEK=current

# WebSocket URL for realtime updates (e.g., wss://realtime.example.com)
VITE_REALTIME_URL=

# Streamer service base URL (e.g., https://streamer.example.com)
VITE_STREAMER_BASE_URL=

# Relay service base URL for HLS stream preview (e.g., https://relay.example.com)
VITE_RELAY_BASE_URL=

# Backend Environment Variables (Node.js - only needed if deploying auth-routes.js)
# These are server-side only

# CORS allowed origins (comma-separated list)
# Example: https://broadcaster.ralph.world,https://app.ralph.world
# If not set or set to '*', all origins are allowed
CORS_ALLOWED_ORIGINS=

# JWT signing secret - REQUIRED in production
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Node environment
NODE_ENV=production

# Server port (Railway sets this automatically)
PORT=3000

# Relay service URL for backend proxy (e.g., https://relay.example.com)
# Backend proxies relay API calls to avoid CORS issues
RELAY_URL=
