{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/src/**",
      "/public/**",
      "/index.html",
      "/package.json",
      "/package-lock.json",
      "/vite.config.ts",
      "/tsconfig.json",
      "/tsconfig.node.json",
      "/nixpacks.toml",
      "/railway.json",
      "/.npmrc"
    ]
  },
  "deploy": {
    "startCommand": "npm run preview",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
