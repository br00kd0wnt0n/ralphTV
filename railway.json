{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/**",
      "!/backend/**",
      "!/streamer/**",
      "!/transcoder/**",
      "!/relay/**",
      "!/docs/**",
      "!/scripts/**",
      "!/.claude/**",
      "!/*.md"
    ]
  },
  "deploy": {
    "startCommand": "npm run preview",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
