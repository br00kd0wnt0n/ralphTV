load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

worker_processes ${NGINX_WORKER_PROCESSES};
events { worker_connections 1024; }

rtmp {
  server {
    listen ${RELAY_RTMP_PORT};
    chunk_size 4096;

    application live {
      live on;
      record off;
      # Push to upstream targets (YouTube, others)
      # These lines are generated by entrypoint from RELAY_PUSH_* vars
      ${RELAY_PUSH_LINES}

      # HLS output for local HTTP serving
      hls on;
      hls_path /tmp/hls;
      hls_fragment 2s;
      hls_playlist_length 10s;
      hls_cleanup on;
    }
  }
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile        on;
  keepalive_timeout  65;

  server {
    listen ${RELAY_HTTP_PORT};
    server_name _;

    # CORS for HLS
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Expose-Headers "Content-Length,Content-Range" always;

    location /hls/ {
      types {
        application/vnd.apple.mpegurl m3u8;
        video/mp2t ts;
      }
      root /tmp;
      add_header Cache-Control no-cache;
      add_header Access-Control-Allow-Origin *;
      add_header Access-Control-Allow-Headers *;
      expires -1;
    }

    location /api/destinations {
      default_type application/json;
      alias /tmp/api/destinations.json;
      add_header Cache-Control no-cache;
      add_header Access-Control-Allow-Origin *;
    }

    location /api/status {
      default_type application/json;
      alias /tmp/api/status.json;
      add_header Cache-Control no-cache;
      add_header Access-Control-Allow-Origin *;
    }

    location /healthz { return 200 'ok'; }
  }
}

