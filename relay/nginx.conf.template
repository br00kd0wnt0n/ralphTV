load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

worker_processes ${NGINX_WORKER_PROCESSES};
error_log /dev/stderr info;

events { worker_connections 1024; }

rtmp {
  server {
    listen ${RELAY_RTMP_PORT};
    chunk_size 4096;
    access_log /dev/stdout;

    application live {
      live on;
      record off;
      # Opt-in publish auth callback (empty unless RELAY_PUBLISH_AUTH_URL is set)
      ${RELAY_ON_PUBLISH}

      # Push to upstream targets (YouTube, others)
      # These lines are generated by entrypoint from RELAY_PUSH_* vars
      ${RELAY_PUSH_LINES}

      # HLS output for local HTTP serving. 2s fragments / 12s playlist (6 segments)
      # give the player real buffer headroom against a real-time (-re) encode — the old
      # 1s/5s left no slack and caused constant rebuffering. Trades ~6s extra latency
      # for smooth playback (does not affect the RTMP push to YouTube).
      hls on;
      hls_path /tmp/hls;
      hls_fragment 2s;
      hls_playlist_length 12s;
      hls_cleanup on;

      # ABR variants (opt-in): populated by entrypoint from RELAY_ABR. When the streamer
      # publishes stream_high + stream_low, these stitch them into a master playlist at
      # stream.m3u8. Empty (and inert) unless RELAY_ABR=true, so single-rendition
      # publishing is unaffected.
      ${RELAY_HLS_VARIANTS}
    }
  }
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile        on;
  keepalive_timeout  65;
  access_log /dev/stdout;

  # NOTE: per-IP HLS limits were removed. Behind Railway's edge proxy nginx only
  # sees the proxy address ($binary_remote_addr is 100.64.0.x for every client), so
  # limit_conn/limit_req bucketed all viewers + pollers + healthchecks together and
  # 503'd legitimate segment requests once ~20 keepalive conns accumulated — the
  # cause of 10-15s playback stalls. They also gave no real DoS protection (can't tell
  # clients apart). Re-add later via real_ip from X-Forwarded-For if needed.

  server {
    listen ${RELAY_HTTP_PORT};
    server_name _;

    # Global CORS headers (applied to all responses including errors)
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
    add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;

    # Handle OPTIONS preflight requests
    if ($request_method = 'OPTIONS') {
      return 204;
    }

    # HLS media segments: immutable, unique filenames (stream-N.ts) that never change
    # once written. Cache them HARD so a CDN (Cloudflare) serves all segment bandwidth
    # from its edge and the relay only uploads each segment once. This is what makes
    # the stream scale past the relay's own ~3 Mbps egress.
    location ~ ^/hls/.+\.ts$ {
      root /tmp;
      types { video/mp2t ts; }
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
      add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # HLS manifest: rewritten every ~2s, so it must NOT be cached (it's tiny — caching
    # it would only make viewers see a stale playlist and stall). Passes through to
    # origin on every poll.
    location ~ ^/hls/.+\.m3u8$ {
      root /tmp;
      types { application/vnd.apple.mpegurl m3u8; }
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
      add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
      add_header Cache-Control "no-cache" always;
    }

    # Fallback for anything else under /hls/ (directory listing, etc.).
    location /hls/ {
      types {
        application/vnd.apple.mpegurl m3u8;
        video/mp2t ts;
      }
      root /tmp;
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
      add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
      add_header Cache-Control "no-cache" always;
    }

    location /api/destinations {
      default_type application/json;
      alias /tmp/api/destinations.json;
      # Explicit CORS for API endpoints
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept" always;
      add_header Cache-Control "no-cache" always;
    }

    location /api/status {
      default_type application/json;
      alias /tmp/api/status.json;
      # Explicit CORS for API endpoints
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept" always;
      add_header Cache-Control "no-cache" always;
    }

    location /healthz {
      add_header Content-Type text/plain;
      return 200 'ok';
    }
  }
}

